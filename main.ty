import random

def task_1():
    print("\n--- Завдання 1: Привітання ---")
    name = input("Введіть ваше ім'я: ")
    age =input("Введіть ваш вік: ")
    print(f"Привіт {name}, тобі {age}!")

def task_2():
    print("\n--- Завдання 2: Перевірка віку ---")
    age = int(input("Введіть ваш вік: "))
    if age >= 18:
        print("Вхід дозволено!")
    else:
        print("Вхід заборонено!")

def task_3():
    print("\n--- Завдання 3: Гра «Вгадай число» ---")
    secret_number = random.randint(1, 10)
    attempts = 3
    print("Я загадав число від 1 до 10. У вас є 3 спроби!")
    for i in range(attempts):
        guess = int(input(f"Спроба {i + 1}. Введіть число: "))
        if guess == secret_number:
            print("Вітаю! Ви вгадали число!")
            break
        elif guess > secret_number:
            print("Менше")
        else:
            print("Більше")
    else:
        print(f"Спроби закінчилися. Число було: {secret_number}")

def task_4():
    print("\n--- Завдання 4: Діапазон чисел ---")
    start = int(input("Введіть початкове число (з): "))
    end = int(input("Введіть кінцеве число (по): "))
    for num in range(start, end + 1):
        print(num, end=" ")
    print()

def task_5():
    print("\n--- Завдання 5: Парні числа назад ---")
    n = int(input("Введіть число n: "))
    for num in range(n, 0, -1):
        if num % 2 == 0:
            print(num, end=" ")
    print()

def task_6():
    print("\n--- Завдання 6: Факторіал ---")
    n = int(input("Введіть число n: "))
    factorial = 1
    for i in range(1, n + 1):
        factorial *= i
    print(f"!{n} = {factorial}")

def task_7():
    print("\n--- Завдання 7: Оцінка ---")
    score = int(input("Введіть кількість балів (0-100): "))
    if 0 <= score <= 49:
        print("незадовільно")
    elif 50 <= score <= 69:
        print("задовільно")
    elif 70 <= score <= 89:
        print("добре")
    elif 90 <= score <= 100:
        print("відмінно")
    else:
        print("Некоректна кількість балів!")

def task_8():
    print("\n--- Завдання 8: Калькулятор ---")
    a = float(input("Введіть перше число (a): "))
    b = float(input("Введіть друге число (b): "))
    operation = input("Вкажіть математичну дію (+, -, *, /): ")
    if operation == "+":
        print(f"Результат: {a + b}")
    elif operation == "-":
        print(f"Результат: {a - b}")
    elif operation == "*":
        print(f"Результат: {a * b}")
    elif operation == "/":
        if b == 0:
            print("Ділення на нуль")
        else:
            print(f"Результат: {a / b}")
    else:
        print("Невідома операція!")

# Головне меню для запуску завдань
while True:
    print("\n================ МЕНЮ ================")
    print("1-8: Запустити відповідне завдання")
    print("0:   Вийти з програми")
    choice = input("Оберіть номер завдання: ")
    
    if choice == "1": task_1()
    elif choice == "2": task_2()
    elif choice == "3": task_3()
    elif choice == "4": task_4()
    elif choice == "5": task_5()
    elif choice == "6": task_6()
    elif choice == "7": task_7()
    elif choice == "8": task_8()
    elif choice == "0":
        print("Програму завершено.")
        break
    else:
        print("Неправильний вибір, спробуйте ще раз.")
